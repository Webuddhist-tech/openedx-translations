  "account.settings.delete.account.text.2.edX": "\u4e00\u65e6\u60a8\u7684\u5e33\u6236\u88ab\u522a\u9664\uff0c\u60a8\u5c31\u7121\u6cd5\u4f7f\u7528\u5b83\u5728 edX \u61c9\u7528\u7a0b\u5f0f\u3001edx.org \u6216 edX \u8a17\u7ba1\u7684\u4efb\u4f55\u5176\u4ed6\u7db2\u7ad9\u4e0a\u5b78\u7fd2\u8ab2\u7a0b\u3002\u9019\u5305\u62ec\u5f9e\u96c7\u4e3b\u6216\u5927\u5b78\u7684\u7cfb\u7d71\u8a2a\u554f edx.org\uff0c\u4ee5\u53ca\u8a2a\u554fMIT Open Learning, Wharton Executive Education, \u548cHarvard Medical School\u63d0\u4f9b\u7684\u79c1\u4eba\u7db2\u7ad9\u3002",
  "account.settings.delete.account.text.3.link": "\u8acb\u6309\u7167\u4ee5\u4e0b\u8aaa\u660e\u5217\u5370\u6216\u4e0b\u8f09\u8b49\u66f8",
