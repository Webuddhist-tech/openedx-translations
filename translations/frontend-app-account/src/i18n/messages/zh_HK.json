  "account.settings.delete.account.text.1": "\u8acb\u6ce8\u610f\uff1a\u60a8\u7684\u5e33\u6236\u548c\u500b\u4eba\u8cc7\u6599\u7684\u522a\u9664\u662f\u6c38\u4e45\u6027\u7684\u4e14\u7121\u6cd5\u64a4\u92b7\u3002 {siteName}\u5c07\u7121\u6cd5\u6062\u5fa9\u60a8\u7684\u5e33\u6236\u6216\u5df2\u522a\u9664\u7684\u8cc7\u6599\u3002",
