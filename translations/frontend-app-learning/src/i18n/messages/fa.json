  "courseCelebration.certificateBody.upgradable": "\u0647\u0646\u0648\u0632 \u0628\u0631\u0627\u06cc \u0627\u0631\u062a\u0642\u0627 \u062f\u06cc\u0631 \u0646\u06cc\u0633\u062a. \u0628\u0631\u0627\u06cc {price} \u0634\u0645\u0627 \u0642\u0641\u0644 \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u0647\u0645\u06c0 \u062a\u06a9\u0627\u0644\u06cc\u0641 \u0645\u0634\u0645\u0648\u0644 \u0646\u0645\u0631\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u062f\u0648\u0631\u0647 \u0631\u0627 \u0628\u0627\u0632 \u062e\u0648\u0627\u0647\u06cc\u062f \u06a9\u0631\u062f. \u067e\u0633 \u0627\u0632 \u0627\u062a\u0645\u0627\u0645\u060c \u06cc\u06a9 \u06af\u0648\u0627\u0647\u06cc \u062a\u0627\u06cc\u06cc\u062f\u0634\u062f\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a \u062e\u0648\u0627\u0647\u06cc\u062f \u06a9\u0631\u062f \u06a9\u0647 \u0627\u0639\u062a\u0628\u0627\u0631 \u0627\u0631\u0632\u0634\u0645\u0646\u062f\u06cc \u0628\u0631\u0627\u06cc \u0628\u0647\u0628\u0648\u062f \u0686\u0634\u0645\u200c\u0627\u0646\u062f\u0627\u0632 \u0634\u063a\u0644\u06cc \u0648 \u067e\u06cc\u0634\u0631\u0641\u062a \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0634\u0645\u0627 \u0627\u0633\u062a\u060c \u06cc\u0627 \u06af\u0648\u0627\u0647\u06cc\u0646\u0627\u0645\u06c0 \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627\u06cc \u0645\u062f\u0631\u0633\u0647 \u0628\u0631\u062c\u0633\u062a\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f.",
